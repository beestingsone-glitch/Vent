{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vent",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vent",
      "database_id": "af16048c-9b59-40c1-84fb-7150d21f1f15"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "SUPER_ADMIN_EMAIL": "beestingsone@gmail.com",
    "JWT_SECRET": "vent-privacy-cloudflare-d1-jwt-super-secret-key-2026"
  }
}
